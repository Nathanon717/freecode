{
  "name": "tty-blocklist-purge",
  "description": "A stored model whose id is on a registry blocklist triggers a startup confirmation naming it; Enter deletes it and models that are not blocklisted are left alone",
  "seedModels": [
    { "provider": "groq", "modelId": "whisper-large-v3", "displayName": "Whisper Large v3" },
    { "provider": "groq", "modelId": "llama-3.3-70b", "displayName": "Llama 3.3 70B" }
  ],
  "tty": {
    "cols": 100,
    "rows": 24,
    "readyText": "blocklisted in the provider registry",
    "steps": [
      {
        "name": "confirmation names the blocklisted model and not the kept one",
        "send": "",
        "screenContains": [
          "1 stored model is now blocklisted",
          "groq:whisper-large-v3",
          "Enter to delete"
        ],
        "screenAbsent": [
          "groq:llama-3.3-70b"
        ]
      },
      {
        "name": "Enter — deletes and hands off to the prompt",
        "send": "\r",
        "waitFor": "Deleted 1 model",
        "screenContains": [
          "> / for commands"
        ]
      }
    ],
    "exit": "\u0003",
    "expectExit": true,
    "exitCode": 0
  }
}
