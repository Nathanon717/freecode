{
  "name": "tty-tool-autobracket",
  "description": "Typing ( after a valid tool name autofills the full argument skeleton with quotes; typing ) at the closing paren types over it; a non-tool name does not autofill",
  "tty": {
    "cols": 80,
    "rows": 24,
    "readyText": "for commands",
    "steps": [
      {
        "name": "type tool name",
        "send": "read",
        "screenContains": [
          "> read"
        ]
      },
      {
        "name": "open paren autofills the argument skeleton",
        "send": "(",
        "screenContains": [
          "> read(path=\"\", offset=, limit=)"
        ],
        "screenAbsent": [
          "read()"
        ]
      },
      {
        "name": "type into the first (path) value slot",
        "send": "x.ts",
        "screenContains": [
          "> read(path=\"x.ts\", offset=, limit=)"
        ]
      },
      {
        "name": "tab from path to the offset slot",
        "send": "\t",
        "screenContains": [
          "> read(path=\"x.ts\", offset=, limit=)"
        ]
      },
      {
        "name": "tab from offset to the last (limit) slot",
        "send": "\t",
        "screenContains": [
          "> read(path=\"x.ts\", offset=, limit=)"
        ]
      },
      {
        "name": "close paren at the last slot types over the autofilled )",
        "send": ")",
        "screenContains": [
          "> read(path=\"x.ts\", offset=, limit=)"
        ],
        "screenAbsent": [
          "limit=))"
        ]
      },
      {
        "name": "clear the buffer",
        "send": "\u001b",
        "screenContains": [
          "> / for commands"
        ]
      },
      {
        "name": "non-tool name does not autofill",
        "send": "notatool",
        "screenContains": [
          "> notatool"
        ]
      },
      {
        "name": "open paren stays a lone bracket",
        "send": "(",
        "screenContains": [
          "> notatool("
        ],
        "screenAbsent": [
          "notatool()",
          "notatool(path"
        ]
      }
    ],
    "exit": "\u0003",
    "expectExit": true,
    "exitCode": 0
  }
}
