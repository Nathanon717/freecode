{
  "version": 1,
  "model": "mock:gpt-freecode-test",
  "steps": [
    {
      "match": {
        "turn": 1,
        "provider": "mock",
        "model": "gpt-freecode-test",
        "mustContain": ["Create note.txt"],
        "toolsAvailable": ["create", "shell_exec"],
        "nativeToolsSupplied": true
      },
      "response": {
        "chunks": ["Writing the file."],
        "toolCalls": [
          {
            "name": "create",
            "args": {
              "path": "note.txt",
              "content": "created by fake llm\n"
            }
          }
        ],
        "usage": { "promptTokens": 20, "outputTokens": 6, "totalTokens": 26 }
      }
    },
    {
      "match": {
        "turn": 2,
        "mustContain": ["<tool_result name=\"create\">"]
      },
      "response": {
        "text": "The snapshot is there.",
        "usage": { "promptTokens": 30, "outputTokens": 5, "totalTokens": 35 }
      }
    }
  ]
}
