{
  "name": "tty-config-keeps-transcript",
  "description": "Leaving /config wipes the screen but not the conversation, so the transcript is reprinted as it was rather than left looking like a fresh session. The replay comes from the render record, so the tool call line and its result preview come back too, not just the text. The '> /config' echo itself is NOT replayed - a slash command never reaches the model, so it is not part of the conversation the record holds. /clear, which really does empty the history, still lands on a bare banner. /model and /eval share the same dispatcher call site but cannot be driven here - the model picker refuses to open under FREECODE_FAKE_LLM=1",
  "model": "mock:gpt-freecode-test",
  "llmFixture": "tty-config-keeps-transcript.llm.json",
  "env": {
    "FREECODE_AUTO_CONFIRM": "1"
  },
  "config": {
    "toolConfirmation": "auto"
  },
  "tty": {
    "cols": 80,
    "rows": 60,
    "readyText": "for commands",
    "steps": [
      {
        "name": "take a turn so there is history to preserve",
        "send": "Say the magic word",
        "screenContains": [
          "> Say the magic word"
        ]
      },
      {
        "name": "submit",
        "send": "\r",
        "waitFor": "xyzzy-first-turn",
        "waitForMs": 20000
      },
      {
        "name": "type /config",
        "send": "/config",
        "screenContains": [
          "> /config"
        ]
      },
      {
        "name": "submit - the config editor opens over the transcript",
        "send": "\r",
        "waitFor": "Tool rationale",
        "waitForMs": 8000
      },
      {
        "name": "press q - the screen is wiped, and the still-live history is reprinted with it",
        "send": "q",
        "screenBlock": [
          "Conversation history (4 messages, still sent to the model):",
          "",
          "> Say the magic word",
          "Checking a file first.",
          "",
          "Looking for the magic word",
          "read(src/util/guards.ts)",
          "re:^ +1: /\\*\\*",
          "...",
          "re:^ +\\d+: \\}$",
          "",
          "re:^─+$",
          "",
          "xyzzy-first-turn"
        ],
        "screenStyles": [
          { "text": "read(src/util/guards.ts)", "fg": "rgb" },
          { "text": "Looking for the magic word", "fg": "rgb" },
          { "text": ": }", "dim": true },
          { "text": "Conversation history", "dim": true },
          { "text": "xyzzy-first-turn", "fg": "default", "dim": false }
        ],
        "screenAbsent": ["> /config"],
        "quietMs": 1500
      },
      {
        "name": "take a second turn on top of the replayed transcript",
        "send": "Say it again",
        "screenContains": [
          "> Say it again"
        ]
      },
      {
        "name": "submit - the live turn continues from the replay, separated by one divider",
        "send": "\r",
        "waitFor": "xyzzy-second-turn",
        "waitForMs": 20000
      },
      {
        "name": "type /config a second time",
        "send": "/config",
        "screenContains": [
          "> /config"
        ]
      },
      {
        "name": "submit - the editor opens over the replayed-then-continued transcript",
        "send": "\r",
        "waitFor": "Tool rationale",
        "waitForMs": 8000
      },
      {
        "name": "press q - both turns come back, and the replay did not record itself",
        "send": "q",
        "screenContains": [
          "still sent to the model",
          "read(src/util/guards.ts)",
          "xyzzy-first-turn",
          "> Say it again",
          "xyzzy-second-turn"
        ],
        "screenAbsent": ["> /config"],
        "screenCounts": {
          "xyzzy-first-turn": 1,
          "xyzzy-second-turn": 1,
          "still sent to the model": 1
        },
        "quietMs": 1500
      },
      {
        "name": "type /clear",
        "send": "/clear",
        "screenContains": [
          "> /clear"
        ]
      },
      {
        "name": "submit - /clear empties the history for real, so nothing is replayed",
        "send": "\r",
        "screenAbsent": [
          "still sent to the model",
          "xyzzy-first-turn"
        ],
        "screenContains": [
          "freecode"
        ],
        "quietMs": 1500
      }
    ],
    "exit": "\u0003",
    "expectExit": true,
    "exitCode": 0
  }
}
