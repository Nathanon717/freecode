{
  "version": 1,
  "model": "mock-native:gpt-freecode-test",
  "steps": [
    {
      "match": {
        "turn": 1,
        "provider": "mock-native",
        "model": "gpt-freecode-test",
        "mustContain": ["what does the package say"],
        "toolsAvailable": ["read"],
        "systemPromptPresent": true,
        "nativeToolsSupplied": true
      },
      "response": {
        "chunks": ["Let me look at it."],
        "toolCalls": [
          {
            "name": "read",
            "args": {
              "rationale": "Reading the manifest the caller asked about",
              "path": "package.json"
            }
          }
        ],
        "usage": { "promptTokens": 20, "outputTokens": 8, "totalTokens": 28 }
      }
    },
    {
      "match": {
        "turn": 2,
        "provider": "mock-native",
        "model": "gpt-freecode-test",
        "nativeToolsSupplied": true
      },
      "response": {
        "text": "The package is named freecode.",
        "usage": { "promptTokens": 40, "outputTokens": 12, "totalTokens": 52 }
      }
    }
  ]
}
